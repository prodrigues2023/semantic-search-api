{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodrigues2023.github.io/semantic-search-api/schemas/search-request.json",
  "title": "SearchRequest",
  "description": "What the caller wants: query, filters, pagination, options. Never how it is found (ADR-0002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "filters": {
      "type": "array",
      "items": { "$ref": "#/$defs/filterCondition" },
      "default": []
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "type": ["string", "null"], "default": null },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "enum": ["hybrid", "semantic", "lexical"], "default": "hybrid" },
        "minScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null }
      }
    }
  },
  "$defs": {
    "filterCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op", "value"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "enum": ["eq", "in", "gte", "lte"] },
        "value": {}
      }
    }
  },
  "examples": [
    {
      "query": "why is my payment failing",
      "filters": [
        { "field": "category", "op": "eq", "value": "billing" },
        { "field": "status", "op": "in", "value": ["open", "pending"] }
      ],
      "pagination": { "cursor": null, "limit": 10 },
      "options": { "profile": "hybrid", "minScore": null }
    }
  ]
}
